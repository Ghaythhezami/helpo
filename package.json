{
  "name": "educator-helper",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm run dev -w @educator-helper/api",
    "dev:teacher": "npm run dev -w @educator-helper/teacher",
    "dev:student": "npm run dev -w @educator-helper/student",
    "build": "npm run build -w @educator-helper/api && npm run build -w @educator-helper/teacher && npm run build -w @educator-helper/student",
    "db:generate": "npm run db:generate -w @educator-helper/api",
    "db:migrate": "npm run db:migrate -w @educator-helper/api"
  },
  "engines": { "node": ">=20.19.0" }
}
