{
  "name": "@helpo/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "*",
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@helpo/shared": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^9.0.0",
    "@vercel/blob": "*",
    "@vercel/functions": "*",
    "better-auth": "^1.7.23",
    "bullmq": "^5.0.0",
    "docx": "^9.0.0",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "ioredis": "^5.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "*",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed.ts"
  }
}
