{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build -w @helpo/shared && npm run build -w @helpo/api",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": { "api/index.js": { "maxDuration": 300, "includeFiles": "{dist/**,prisma/**,node_modules/.prisma/**}" } }
}
