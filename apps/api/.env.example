# Server
PORT=3001
# The web app origin (alias WEB_ORIGIN). Extra allowed origins, comma separated:
WEB_URL="http://localhost:3000"
CORS_ORIGINS=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
STUDENT_COOKIE_SECRET="replace-with-another-random-secret-16+-chars"

# Database (Neon pooled URL in production)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/helpo?schema=public"

# Redis: BullMQ and shared rate limits (leave empty for the inline driver)
REDIS_URL=""

# AI (leave ANTHROPIC_API_KEY empty for offline demo mode, or set AI_MODE=demo)
ANTHROPIC_API_KEY=""
CLAUDE_ANALYSIS_MODEL="claude-opus-5-5"
CLAUDE_GEN_MODEL="claude-sonnet-5-5"
CLAUDE_EFFORT="medium"

# Drivers: inline + poll on Vercel; bullmq + socket on Railway / a long-running host
QUEUE_DRIVER="inline"
REALTIME="poll"
WORKER_ONLY="false"
API_WS_URL=""

# Limits
MAX_UPLOAD_MB=20
MONTHLY_LESSON_QUOTA=100

# Optional: keep the original upload (Vercel Blob). Without it only the clean text and the sha256 are stored.
BLOB_READ_WRITE_TOKEN=""

# Optional observability and admin
SENTRY_DSN=""
ADMIN_EMAILS=""

# Pre-configured demo access (off by default). DEMO_PASSWORD is a secret: set it in the host, never in code.
DEMO_LOGIN=""
DEMO_PASSWORD=""
DEMO_LESSON_QUOTA=""
